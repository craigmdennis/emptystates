---
/**
 * The shell every page sits in: header, footer, and the view mode.
 *
 * `data-view` lives on `<html>` because both gallery layouts are the same DOM
 * under different CSS — see `global.css`. That is what lets the switch be a
 * link that works without JavaScript, and an attribute flip when there is any.
 */
import "../styles/global.css";
import { getDb } from "../db/client";
import { countStates } from "../db/states";
import { canonicalPath } from "../lib/canonical";
import Logo from "../components/Logo.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "A curated gallery of empty state UI designs",
  image,
} = Astro.props;

const siteTitle = "emptystat.es";
const fullTitle = title === siteTitle ? title : `${title} — ${siteTitle}`;
const canonicalUrl = new URL(
  canonicalPath(Astro.url),
  Astro.site ?? "https://emptystat.es",
);

const total = await countStates(getDb());

// Server default. The inline script below corrects it to the stored choice
// before first paint, so nobody sees the other layout flash past.
const requested = Astro.url.searchParams.get("view");
const view = requested === "square" ? "square" : "justified";
---

<!doctype html>
<html lang="en" data-view={view}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script is:inline>
      // `/privacy` states that the switch there is the only thing that stops
      // this, and that an ad blocker will not. So the three signals are read
      // before the script is requested, rather than after it has loaded.
      try {
        var out =
          localStorage.getItem("es:optout") === "1" ||
          navigator.doNotTrack === "1" ||
          navigator.globalPrivacyControl === true;
        if (!out) {
          var s = document.createElement("script");
          s.defer = true;
          s.src = "https://plausible.io/js/pa-mcGkDVqdn7WDFxJz2eI03.js";
          document.head.appendChild(s);
        }
      } catch (e) {}
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Spectral:wght@400;500&display=swap"
    />

    <script is:inline>
      // Blocking on purpose: deferred, this would run after first paint and the
      // reader would watch the wrong layout become the right one.
      try {
        var q = new URLSearchParams(location.search).get("view");
        if (q === "square" || q === "justified") {
          localStorage.setItem("es:view", q);
        } else {
          var v = localStorage.getItem("es:view");
          if (v === "square" || v === "justified") {
            document.documentElement.dataset.view = v;
          }
        }
      } catch (e) {}
    </script>
  </head>

  <body class="shell">
    <header class="site-header">
      <div class="wrap">
        <a href="/" class="wordmark">
          <Logo size={17} />
          <strong>Emptystates</strong>
          <span class="mono-11">{total} entries</span>
        </a>

        <nav class="site-nav">
          {Astro.locals.admin && <a href="/admin">Admin</a>}
          <a href="/privacy">Privacy</a>
        </nav>
      </div>
    </header>

    <main class="site-main">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap mono">
        <span
          >Emptystates — {total} empty-state screenshots from real software. Growing
          by submission.</span
        >
        <nav class="mono">
          <a href="/privacy">Privacy</a>
          <span>Screenshots belong to their authors</span>
        </nav>
      </div>
    </footer>

    <script is:inline>
      // The switch is a link and stays one. This only saves the round trip:
      // both layouts are already in the DOM, so flipping the attribute is the
      // whole change.
      document.addEventListener("click", function (ev) {
        var link = ev.target instanceof Element && ev.target.closest("[data-mode]");
        if (!link || ev.metaKey || ev.ctrlKey || ev.shiftKey) return;
        ev.preventDefault();
        var mode = link.getAttribute("data-mode");
        document.documentElement.dataset.view = mode;
        try {
          localStorage.setItem("es:view", mode);
        } catch (e) {}
        history.replaceState(null, "", link.getAttribute("href"));
      });
    </script>
  </body>
</html>
