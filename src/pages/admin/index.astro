---
/**
 * The admin's front door, two stacked queues: Uploaded (pending submissions,
 * image in R2 and metadata still owed) and Submitted (unpublished states).
 * Neither has a public page, so these grids are their only route back.
 */
import Admin from "../../layouts/Admin.astro";
import type { NoticeProps } from "../../components/admin/Notice.astro";
import { getDb } from "../../db/client";
import { listDraftStates } from "../../db/states";
import { listPendingDrafts } from "../../db/submissions";
import { imageSources } from "../../lib/images";
import { mediaUrl } from "../../lib/media";

const db = getDb();
const [drafts, uploads] = await Promise.all([listDraftStates(db), listPendingDrafts(db)]);

const published = Astro.url.searchParams.get("published");
const unpublished = Astro.url.searchParams.get("unpublished");
const notice: NoticeProps | null = published
  ? { tone: "ok", text: `Published ${published}`, href: `/s/${published}` }
  : unpublished
    ? { tone: "ok", text: `Unpublished ${unpublished}` }
    : null;
---

<Admin title="Drafts" notice={notice}>
  <p class="mb-4 flex flex-wrap items-center gap-4 text-sm text-[var(--muted)]">
    <a href="/admin/new" class="rounded-lg bg-[var(--ink)] px-4 py-2 font-semibold text-white">
      Add screenshots
    </a>
    <a href="/" class="ml-auto underline">Gallery</a>
  </p>

  {
    uploads.length > 0 && (
      <section class="mb-6">
        <h2 class="mb-2 text-sm font-semibold">Drafts</h2>
        <ul class="grid grid-cols-3 gap-2 md:grid-cols-5 lg:grid-cols-6">
          {uploads.map((u) => (
            <li>
              <a href={`/admin/new?draft=${u.id}`} class="block">
                <img
                  src={mediaUrl(u.r2_key)}
                  alt=""
                  width={u.width}
                  height={u.height}
                  loading="lazy"
                  class="aspect-square w-full rounded bg-[var(--chip)] object-contain"
                />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class={uploads.length > 0 ? "border-t border-[var(--rule)] pt-6" : ""}>
    <h2 class="mb-2 text-sm font-semibold">Submitted</h2>
    {
      drafts.length === 0 ? (
        <p class="text-sm text-[var(--muted)]">No submissions.</p>
      ) : (
        <ul class="grid grid-cols-3 gap-2 md:grid-cols-5 lg:grid-cols-6">
          {drafts.map((s) => (
            <li>
              <a href={`/admin/edit/${s.id}`} class="block">
                <img
                  src={imageSources(s).src}
                  alt=""
                  width={s.width}
                  height={s.height}
                  loading="lazy"
                  class="aspect-square w-full rounded bg-[var(--chip)] object-contain"
                />
                <span class="mt-1 block truncate text-xs text-[var(--muted)]">{s.title}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Admin>
