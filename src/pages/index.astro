---
import Layout from "../layouts/Base.astro";
import Gallery from "../components/Gallery.astro";
import GalleryCard from "../components/GalleryCard.astro";
import Pagination from "../components/Pagination.astro";
import { getEmDashCollection } from "emdash";
import FilterBar from "../components/FilterBar.astro";
import FocusModeToggle from "../components/FocusModeToggle.tsx";

const ITEMS_PER_PAGE = 60;

const url = Astro.url;
const page = Math.max(1, parseInt(url.searchParams.get("page") ?? "1", 10));
const deviceFilter = url.searchParams.get("device") ?? undefined;
const platformFilter = url.searchParams.get("platform") ?? undefined;
const tagsFilter = url.searchParams.getAll("tags");

// Fetch entries
let allEntries: any[] = [];
try {
  const result = await getEmDashCollection("states");
  console.log("[DEBUG] getEmDashCollection result:", JSON.stringify({
    entriesCount: result.entries?.length ?? 0,
    error: result.error?.message ?? null,
    keys: Object.keys(result),
  }));
  allEntries = result.entries ?? [];
} catch (e: any) {
  console.error("[DEBUG] getEmDashCollection threw:", e?.message ?? e);
}

const hasNextPage = allEntries.length > ITEMS_PER_PAGE;
const entries = allEntries.slice(0, ITEMS_PER_PAGE);

// Page title
const filterLabel = deviceFilter
  ? deviceFilter.charAt(0).toUpperCase() + deviceFilter.slice(1)
  : null;
const title = filterLabel ? `${filterLabel} Empty States` : "emptystat.es";
---

<Layout title={title}>
  {entries.length > 0 ? (
    <>
      <FilterBar
        activeDevice={deviceFilter}
        activePlatform={platformFilter}
        activeTags={tagsFilter}
      />
      <div class="flex justify-end mb-3">
        <FocusModeToggle client:idle />
      </div>
      <Gallery>
        {entries.map((entry) => (
          <GalleryCard
            slug={entry.data.slug}
            title={entry.data.title}
            imageUrl={entry.data.screenshot?.url ?? ""}
            imageAlt={entry.data.screenshot?.alt}
            deviceType={entry.data.device_type}
            focalX={entry.data.focal_x}
            focalY={entry.data.focal_y}
          />
        ))}
      </Gallery>

      <Pagination
        currentPage={page}
        hasNextPage={hasNextPage}
        baseUrl={url}
      />
    </>
  ) : (
    <div class="flex flex-col items-center justify-center py-24 text-center">
      <p class="text-base-content/40 text-sm font-mono">No states found</p>
      {(deviceFilter || platformFilter) && (
        <a href="/" class="btn btn-sm btn-ghost font-mono mt-4">Clear filters</a>
      )}
    </div>
  )}
</Layout>
