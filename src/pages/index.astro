---
import Layout from "../layouts/Base.astro";
import Gallery from "../components/Gallery.astro";
import GalleryCard from "../components/GalleryCard.astro";
import Pagination from "../components/Pagination.astro";
import { getEmDashCollection } from "emdash";
import FilterBar from "../components/FilterBar.astro";
import FocusModeToggle from "../components/FocusModeToggle.tsx";

const ITEMS_PER_PAGE = 60;

const url = Astro.url;
const page = Math.max(1, parseInt(url.searchParams.get("page") ?? "1", 10));
const deviceFilter = url.searchParams.get("device") ?? undefined;
const platformFilter = url.searchParams.get("platform") ?? undefined;
const tagsFilter = url.searchParams.getAll("tags");

// Fetch all published entries (235 total — fine to load at once)
const { entries: allPublished = [] } = await getEmDashCollection("states", {
  status: "published",
  limit: 1000,
});

// Filter in-memory (EMDash where clause only supports taxonomy fields)
const hasFilters = deviceFilter || platformFilter || tagsFilter.length > 0;
const filtered = hasFilters
  ? allPublished.filter((entry) => {
      if (deviceFilter && entry.data.device_type !== deviceFilter) return false;
      if (platformFilter && entry.data.platform !== platformFilter) return false;
      if (tagsFilter.length > 0) {
        const entryTags: string[] = entry.data.tags ?? [];
        if (!tagsFilter.some((t) => entryTags.includes(t))) return false;
      }
      return true;
    })
  : allPublished;

// Split by device category
const wideTypes = new Set(["desktop", "tv", "game"]);

// Paginate
const start = (page - 1) * ITEMS_PER_PAGE;
const hasNextPage = filtered.length > start + ITEMS_PER_PAGE;
const entries = filtered.slice(start, start + ITEMS_PER_PAGE);

// Split paginated entries into sections
const paginatedMobile = entries.filter((e) => !wideTypes.has(e.data.device_type));
const paginatedDesktop = entries.filter((e) => wideTypes.has(e.data.device_type));

// Derive available platforms and tags from actual data
const availablePlatforms = [...new Set(allPublished.map((e) => e.data.platform).filter(Boolean))].sort();
const availableTags = [...new Set(allPublished.flatMap((e) => e.data.tags ?? []))].sort();

// Page title
const filterLabel = deviceFilter
  ? deviceFilter.charAt(0).toUpperCase() + deviceFilter.slice(1)
  : null;
const title = filterLabel ? `${filterLabel} Empty States` : "emptystat.es";
---

<Layout title={title}>
  <FilterBar
    activeDevice={deviceFilter}
    activePlatform={platformFilter}
    activeTags={tagsFilter}
    platforms={availablePlatforms}
    tags={availableTags}
  />

  {entries.length > 0 ? (
    <>
      <div class="flex justify-end mb-3">
        <FocusModeToggle client:idle />
      </div>
      {paginatedMobile.length > 0 && (
        <section>
          {paginatedDesktop.length > 0 && (
            <h2 class="text-xs font-mono text-base-content/40 uppercase tracking-wider mb-3" data-label>Mobile</h2>
          )}
          <Gallery>
            {paginatedMobile.map((entry) => (
              <GalleryCard
                slug={entry.data.slug}
                title={entry.data.title}
                imageUrl={entry.data.screenshot?.url ?? ""}
                imageAlt={entry.data.screenshot?.alt}
                deviceType={entry.data.device_type}
                focalX={entry.data.focal_x}
                focalY={entry.data.focal_y}
              />
            ))}
          </Gallery>
        </section>
      )}

      {paginatedDesktop.length > 0 && (
        <section class={paginatedMobile.length > 0 ? "mt-10" : ""}>
          {paginatedMobile.length > 0 && (
            <h2 class="text-xs font-mono text-base-content/40 uppercase tracking-wider mb-3" data-label>Desktop</h2>
          )}
          <Gallery>
            {paginatedDesktop.map((entry) => (
              <GalleryCard
                slug={entry.data.slug}
                title={entry.data.title}
                imageUrl={entry.data.screenshot?.url ?? ""}
                imageAlt={entry.data.screenshot?.alt}
                deviceType={entry.data.device_type}
                focalX={entry.data.focal_x}
                focalY={entry.data.focal_y}
              />
            ))}
          </Gallery>
        </section>
      )}

      <Pagination
        currentPage={page}
        hasNextPage={hasNextPage}
        baseUrl={url}
      />
    </>
  ) : (
    <div class="flex flex-col items-center justify-center py-24 text-center">
      <p class="text-base-content/40 text-sm font-mono">No states found</p>
    </div>
  )}
</Layout>
