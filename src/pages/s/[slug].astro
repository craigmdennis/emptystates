---
/**
 * Placeholder detail page. Task 10 replaces it with the viewport-filling one.
 *
 * The screenshot and its metadata, unstyled. `sizes="100vw"` lets the browser
 * pick the widest variant it needs, which is why `w2560` exists — 5 states have
 * one. The other 230 top out lower, and 8 have no variant and are served their
 * original.
 */
import Layout from "../../layouts/Base.astro";
import { getDb } from "../../db/client";
import { getAdjacent, getStateBySlug } from "../../db/states";
import { imageSources } from "../../lib/images";

const { slug } = Astro.params;
const db = getDb();
const state = slug ? await getStateBySlug(db, slug) : null;

if (!state) {
  return new Response("Not found", { status: 404 });
}

const { prev, next } = await getAdjacent(db, state.published_at);
const { src, srcset } = imageSources(state);
---

<Layout title={state.title} description={state.description ?? undefined}>
  <article class="font-mono text-sm grid gap-4">
    <h1 class="text-lg font-bold">{state.title}</h1>

    <img
      src={src}
      srcset={srcset || undefined}
      sizes="100vw"
      width={state.width}
      height={state.height}
      alt={state.title}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="max-w-full h-auto"
    />

    <dl class="grid grid-cols-[8rem_1fr] gap-x-4">
      <dt class="text-base-content/50">App</dt>
      <dd>{state.app_name ?? "unknown"}</dd>
      <dt class="text-base-content/50">Device</dt>
      <dd>{state.device_type}</dd>
      <dt class="text-base-content/50">OS</dt>
      <dd>{state.os ?? "unknown"}</dd>
      <dt class="text-base-content/50">Size</dt>
      <dd>{state.width}&times;{state.height} — ratio {state.aspect_ratio.toFixed(3)}</dd>
      <dt class="text-base-content/50">Original</dt>
      <dd>{state.r2_key} — {Math.round(state.byte_size / 1024)} KB</dd>
      <dt class="text-base-content/50">Published</dt>
      <dd>{state.published_at.slice(0, 10)}</dd>
    </dl>
  </article>

  <nav class="flex gap-3 font-mono text-xs mt-8" aria-label="Adjacent states">
    {prev && <a href={`/s/${prev.slug}`} class="hover:underline">← {prev.title}</a>}
    {next && <a href={`/s/${next.slug}`} class="hover:underline">{next.title} →</a>}
  </nav>
</Layout>
