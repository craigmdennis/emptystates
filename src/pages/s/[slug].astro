---
/**
 * One entry: the screenshot on the left, everything known about it on the
 * right, and neither of them scrolling.
 *
 * The image is capped by the column, by the viewport height and by its own
 * pixel size at once — see `.detail-figure img`. A screenshot enlarged past
 * its own resolution is a worse copy of itself, and 206 of these are 640px
 * wide or less.
 *
 * Previous and Next step through the gallery's reading order — Next is the
 * tile that sat after this one, which is the older entry. They do not follow
 * the filtered order the reader arrived from: carrying the filter through
 * would mean putting it in every card's href.
 */
import Layout from "../../layouts/Base.astro";
import { getDb } from "../../db/client";
import {
  countStates,
  getAdjacent,
  getStateBySlug,
  listStateTags,
} from "../../db/states";
import { imageSources } from "../../lib/images";
import { isPlaceholderTitle } from "../../lib/titles";
import Icon from "../../components/Icon.astro";
import Dimensions from "../../components/Dimensions.astro";
import { mediaUrl } from "../../lib/media";

const { slug } = Astro.params;
const db = getDb();
const state = slug ? await getStateBySlug(db, slug) : null;

if (!state) {
  return new Response("Not found", { status: 404 });
}

const [{ prev, next, position }, tags, total] = await Promise.all([
  getAdjacent(db, state.published_at),
  listStateTags(db, state.id),
  countStates(db),
]);

const { src, srcset } = imageSources(state);
const placeholder = isPlaceholderTitle(state.title);
const alt = placeholder ? "Empty state screenshot" : state.title;

// A row exists when there is something to put in it. Device, Published and
// Size are the three every entry carries; app name and OS are missing from
// most of the collection, and printing "unknown" 178 times says nothing.
type MetaRow = {
  key: string;
  value?: string;
  /** Width and height, drawn with a cross between them by `Dimensions`. */
  dims?: [number, number];
  num?: boolean;
};

const rows: MetaRow[] = [
  ...(state.app_name ? [{ key: "App", value: state.app_name }] : []),
  { key: "Device", value: state.device_type },
  ...(state.os ? [{ key: "OS", value: state.os }] : []),
  { key: "Size", dims: [state.width, state.height], num: true },
  {
    key: "Published",
    value: state.published_at.slice(0, 10),
    num: true,
  },
  { key: "Entry", value: `${position} / ${total}`, num: true },
];

// The absences, said once and quietly, rather than a column of holes.
const missing = [
  state.app_name ? null : "app name",
  state.os ? null : "operating system",
].filter(Boolean);

const format = state.r2_key.split(".").pop()?.toUpperCase() ?? "PNG";
const kb = Math.round(state.byte_size / 1024);
---

<Layout title={state.title} description={state.description ?? undefined}>
  <div class="detail-bar">
    <a href="/" class="back">
      <Icon name="arrow-left" size={10} />
      <span>Gallery</span>
    </a>
    <nav aria-label="Adjacent entries">
      <span>{position} / {total}</span>
      {
        prev ? (
          <a href={`/s/${prev.slug}`} rel="prev">
            Previous
          </a>
        ) : (
          <span aria-disabled="true">Previous</span>
        )
      }
      {
        next ? (
          <a href={`/s/${next.slug}`} rel="next">
            Next
          </a>
        ) : (
          <span aria-disabled="true">Next</span>
        )
      }
    </nav>
  </div>

  <article class="detail">
    <figure
      class="detail-figure"
      style={`--nat-w:${state.width}px;--nat-h:${state.height}px;--ar:${state.aspect_ratio.toFixed(4)}`}
    >
      <img
        id="shot"
        src={src}
        srcset={srcset || undefined}
        sizes="(max-width: 960px) 100vw, 60vw"
        width={state.width}
        height={state.height}
        alt={alt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption class="mono dotted" id="scale">
        <span id="scale-pct" hidden></span>
        <Dimensions width={state.width} height={state.height} />
      </figcaption>
    </figure>

    <div class="detail-meta">
      {
        placeholder ? (
          <div>
            <h1 class="title-file">{state.title}</h1>
            <p class="mono" style="margin: 8px 0 0;">
              Original filename. No title recorded yet.
            </p>
          </div>
        ) : (
          <h1 class="title-serif">{state.title}</h1>
        )
      }

      <dl>
        {
          rows.map((row) => (
            <>
              <dt>{row.key}</dt>
              <dd class={row.num ? "num" : undefined}>
                {row.dims ? (
                  <Dimensions width={row.dims[0]} height={row.dims[1]} />
                ) : (
                  row.value
                )}
              </dd>
            </>
          ))
        }
      </dl>

      {
        missing.length > 0 && (
          <p class="mono" style="color: var(--faint-2);">
            Not recorded: {missing.join(", ")}
          </p>
        )
      }

      {
        tags.length > 0 && (
          <div class="chips">
            {tags.map((tag) => (
              <a class="chip" href={`/?tag=${tag.slug}`}>
                {tag.label}
              </a>
            ))}
          </div>
        )
      }

      <p class="original">
        <a
          class="external"
          href={mediaUrl(state.r2_key)}
          target="_blank"
          rel="noopener"
        >
          <span>Show original</span>
          <Icon name="external" size={10} />
          <span class="sr-only">(opens in a new tab)</span>
        </a>
        <span class="mono dotted">
          <span>{format}</span>
          <span>{kb} KB</span>
          <Dimensions width={state.width} height={state.height} />
        </span>
      </p>

      {
        Astro.locals.admin && (
          <p class="original">
            <a href={`/admin/edit/${state.id}`}>Edit</a>
          </p>
        )
      }
    </div>
  </article>

  <script is:inline>
    // Whether the screenshot is at its own size, which for a reference archive
    // is worth knowing. The caption is already correct without this; the script
    // only adds the percentage once the rendered width is a fact.
    (function () {
      var img = document.getElementById("shot");
      // Only the percentage is scripted. The dimensions beside it are markup —
      // a `Dimensions` component with a drawn cross — so this writes into its
      // own span rather than replacing the caption, which would delete them.
      // The dot between the two is drawn by `.dotted`, and appears with the
      // span: `[hidden]` is what holds it back until there is a figure to show.
      var pctEl = document.getElementById("scale-pct");
      if (!img || !pctEl) return;

      // The original's width, off the attribute — not naturalWidth, which is
      // whichever variant the browser chose and would report a 640px copy of a
      // 1280px screenshot as full size.
      var full = Number(img.getAttribute("width"));
      if (!full) return;

      function render() {
        var pct = Math.round((img.clientWidth / full) * 100);
        if (!pct) return;
        pctEl.textContent =
          pct >= 100 ? "actual size" : "shown at " + pct + "%";
        pctEl.hidden = false;
      }

      render();
      addEventListener("resize", render);
    })();
  </script>
</Layout>
