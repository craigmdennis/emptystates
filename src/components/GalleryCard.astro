---
/**
 * A single card in the gallery grid.
 *
 * - Fixed 4:3 aspect ratio container
 * - Image constrained to width, centered vertically
 * - Background fill for leftover space
 * - Wide device types (desktop, tv, game) span 2 columns
 * - Hover: zoom + pan via ZoomIsland React component
 * - Custom property --focal-x/--focal-y for focus mode cropping
 */
import ZoomIsland from "./ZoomIsland.tsx";

interface Props {
  slug: string;
  title: string;
  imageUrl: string;
  imageAlt?: string;
  deviceType: string;
  focalX?: number;
  focalY?: number;
}

const {
  slug,
  title,
  imageUrl,
  imageAlt,
  deviceType,
  focalX = 50,
  focalY = 50,
} = Astro.props;

const isWide = ["desktop", "tv", "game"].includes(deviceType);
---

<div
  class:list={[
    "group relative rounded-md overflow-hidden bg-base-200 aspect-[4/3]",
    isWide && "col-span-2",
  ]}
  style={`--focal-x: ${focalX}%; --focal-y: ${focalY}%;`}
>
  <a
    href={`/s/${slug}/`}
    class="block w-full h-full"
  >
    <ZoomIsland
      client:visible
      src={imageUrl}
      alt={imageAlt || title}
      focalX={focalX}
      focalY={focalY}
    />
  </a>

  <!-- Title overlay on hover -->
  <div class="absolute inset-x-0 bottom-0 p-2 bg-gradient-to-t from-black/70 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none">
    <span class="text-white text-xs font-mono leading-tight line-clamp-2">
      {title}
    </span>
  </div>

  <!-- Device type badge -->
  <span
    class="absolute top-2 right-2 badge badge-xs badge-neutral font-mono opacity-0 group-hover:opacity-100 transition-opacity duration-200"
    data-label
  >
    {deviceType}
  </span>
</div>
