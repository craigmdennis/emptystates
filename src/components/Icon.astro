---
/**
 * Every icon the site draws, as path data in one map.
 *
 * Icons are not typed as characters and not pasted as `<svg>` into templates.
 * A character sits inside a text run, and the whitespace either side of a text
 * run is what the compiler collapses under JSX rules; an icon is a flex item,
 * and a `gap` cannot be collapsed away. Path data in one place also means the
 * grid, the stroke and the joins are decided once, in `.icon`.
 *
 * Decorative by default. `label` is for an icon that carries meaning no
 * adjacent text repeats: `times` between two numbers is announced as "by",
 * which the multiplication sign it replaced was not.
 */
const paths = {
  /** Leaves the site. The corner, then the diagonal through it. */
  external: ["M4 2h6v6", "M10 2 2.5 9.5"],
  /** Back to the gallery. */
  "arrow-left": ["M7 2 3 6l4 4"],
  /** Between a width and a height. */
  times: ["M3 3l6 6", "M9 3l-6 6"],
  /** Between the two ends of a range. */
  dash: ["M2 6h8"],
} as const;

interface Props {
  name: keyof typeof paths;
  /** Announced name. Omitted leaves the icon out of the accessibility tree. */
  label?: string;
  size?: number;
  class?: string;
}

const { name, label, size = 12, class: className } = Astro.props;
---

<svg
  class:list={["icon", className]}
  viewBox="0 0 12 12"
  width={size}
  height={size}
  role={label ? "img" : undefined}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  {label && <title>{label}</title>}
  {paths[name].map((d) => <path d={d} />)}
</svg>
