---
interface Props {
  currentPage: number;
  hasNextPage: boolean;
  baseUrl: URL;
}

const { currentPage, hasNextPage, baseUrl } = Astro.props;

function pageUrl(page: number): string {
  const url = new URL(baseUrl);
  if (page > 1) {
    url.searchParams.set("page", String(page));
  } else {
    url.searchParams.delete("page");
  }
  return url.pathname + url.search;
}

const hasPrev = currentPage > 1;
---

{(hasPrev || hasNextPage) && (
  <nav class="flex items-center justify-center gap-4 py-8" aria-label="Pagination">
    {hasPrev ? (
      <a href={pageUrl(currentPage - 1)} class="btn btn-sm btn-ghost font-mono">
        &larr; Prev
      </a>
    ) : (
      <span class="btn btn-sm btn-ghost font-mono btn-disabled">&larr; Prev</span>
    )}

    <span class="text-xs text-base-content/50 font-mono tabular-nums">
      Page {currentPage}
    </span>

    {hasNextPage ? (
      <a href={pageUrl(currentPage + 1)} class="btn btn-sm btn-ghost font-mono">
        Next &rarr;
      </a>
    ) : (
      <span class="btn btn-sm btn-ghost font-mono btn-disabled">Next &rarr;</span>
    )}
  </nav>
)}
