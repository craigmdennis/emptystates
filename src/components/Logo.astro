---
/**
 * The mark, carried over from the Gatsby site unchanged.
 *
 * Separate from `Icon.astro` because it is neither an icon nor on its grid:
 * that component draws 12x12 stroked paths, and this is one filled path on a
 * 338-unit box. `source.test.ts` names this file alongside it.
 *
 * `fill="currentColor"`, so the header colour reaches it and dark mode needs
 * no second copy.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 18, class: className } = Astro.props;
---

<svg
  class:list={["logo", className]}
  viewBox="0 0 338 338"
  width={size}
  height={size}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
