---
/**
 * The fields a state carries, shared by the capture screen (empty, device
 * derived from the image) and the edit screen (pre-filled from the row).
 * The surrounding `<form>`, hidden ids, and buttons belong to each page.
 */
import type { DeviceRangeOption } from "../../db/taxonomies";

type Option = { slug: string; label: string };

interface Props {
  devices: DeviceRangeOption[];
  oses: Option[];
  tagOptions: Option[];
  appNames: string[];
  values?: {
    deviceType?: string | null;
    os?: string | null;
    appName?: string | null;
    title?: string | null;
    appUrl?: string | null;
    tagSlugs?: string[];
  };
}

const { devices, oses, tagOptions, appNames, values = {} } = Astro.props;
const tagSlugs = new Set(values.tagSlugs ?? []);

const chip =
  "rounded-full bg-[var(--chip)] px-3 py-1.5 text-sm peer-checked:bg-[var(--ink)] peer-checked:text-white";
const field =
  "rounded border border-[var(--rule)] bg-[var(--raised)] px-3 py-2 text-base text-[var(--ink)]";
const label = "flex flex-col gap-1 text-sm font-medium text-[var(--muted)]";
const legend = "mb-2 text-sm font-medium text-[var(--muted)]";
---

<fieldset>
  <legend class={legend}>Device</legend>
  <div class="flex flex-wrap gap-2">
    {
      devices.map((d) => (
        <label class="cursor-pointer">
          <input
            type="radio"
            name="device_type"
            value={d.slug}
            class="peer sr-only"
            checked={d.slug === values.deviceType}
            required
          />
          <span class={chip}>{d.label}</span>
        </label>
      ))
    }
  </div>
</fieldset>

<fieldset>
  <legend class={legend}>OS</legend>
  <div class="flex flex-wrap gap-2">
    {
      oses.map((o) => (
        <label class="cursor-pointer">
          <input
            type="radio"
            name="os"
            value={o.slug}
            class="peer sr-only"
            checked={o.slug === values.os}
            required
          />
          <span class={chip}>{o.label}</span>
        </label>
      ))
    }
  </div>
</fieldset>

<label class={label}>
  App name
  <input
    name="app_name"
    list="apps"
    required
    autocapitalize="words"
    value={values.appName ?? ""}
    class={field}
  />
</label>
<datalist id="apps">
  {appNames.map((name) => <option value={name} />)}
</datalist>

<label class={label}>
  Title
  <input
    name="title"
    required
    placeholder="No results in Feedly"
    value={values.title ?? ""}
    class={field}
  />
</label>

<fieldset>
  <legend class={legend}>Tags</legend>
  <div class="flex flex-wrap gap-2">
    {
      tagOptions.map((t) => (
        <label class="cursor-pointer">
          <input
            type="checkbox"
            name="tags"
            value={t.slug}
            class="peer sr-only"
            checked={tagSlugs.has(t.slug)}
          />
          <span class={chip}>{t.label}</span>
        </label>
      ))
    }
  </div>
</fieldset>

<label class={label}>
  App URL (optional)
  <input
    name="app_url"
    type="url"
    inputmode="url"
    value={values.appUrl ?? ""}
    class={field}
  />
</label>
