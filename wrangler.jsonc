{
  "$schema": "node_modules/wrangler/config-schema.json",

  // **This is the staging Worker.** A bare `wrangler deploy` publishes
  // `emptystates-v2` on its workers.dev address and cannot reach
  // emptystat.es. The live Worker is called `emptystates`, and reaching it
  // takes `npm run deploy:production`, which asks for typed confirmation.
  //
  // The name is inverted on purpose. On 2026-08-23 a
  // `wrangler deploy --env staging` replaced the live Gatsby site, because
  // the Astro adapter flattens this file into `dist/server/wrangler.json` and
  // drops the `env` block while keeping `definedEnvironments`. The flag
  // validated, found no environment to apply, and fell through to the
  // top-level name. With the safe name on top, that same mistake now
  // publishes staging.
  //
  // **Do not add an `env` block here.** It does not survive a build, and
  // `test/deploy-safety.test.ts` fails if one appears. The deploy target is
  // set by `scripts/deploy.ts`, which patches the generated config's `name` —
  // the field wrangler actually reads.
  "name": "emptystates-v2",
  "workers_dev": true,

  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],

  // Staging and production read the same data. The rebuild only reads, so a
  // staging session cannot change what the live site serves.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emptystates-db",
      "database_id": "a695d0d3-a878-4ada-be03-380fd207c773",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "emptystates-media"
    }
  ]

  // No `queues` block. The ingest producer and consumer belong to spec 02,
  // and nothing in src/ references the INGEST binding. Declaring a consumer
  // for a queue that does not exist fails the deploy, and the Astro adapter's
  // Worker exports no queue() handler. Add both back with #33.
  //
  // `wrangler d1` commands need `--config wrangler.jsonc` after any build.
  // `.wrangler/deploy/config.json` points wrangler at the generated config,
  // where D1 commands fail with API error 7403.
}
